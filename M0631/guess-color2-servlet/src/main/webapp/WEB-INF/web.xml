<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
        version="6.0" metadata-complete="false">

		<welcome-file-list>
			<welcome-file>guess-color2</welcome-file>
		</welcome-file-list>
		<servlet>
			<servlet-name>GuessColor2Servlet</servlet-name>
			<display-name>GuessColor2Servlet</display-name>
			<description></description>
			<servlet-class>cat.institutmarianao.guess.color2.servlet.GuessColor2Servlet</servlet-class>
			<init-param>
				<param-name>color</param-name>
				<param-value>red</param-value>
				<description></description>
			</init-param>
		</servlet>
		<servlet-mapping>
			<servlet-name>GuessColor2Servlet</servlet-name>
			<url-pattern>/GuessColor2Servlet</url-pattern>
		</servlet-mapping>
		
        <session-config>
                <session-timeout>30</session-timeout>
        </session-config>
</web-app>
